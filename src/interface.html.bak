<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Industrial Monitor | Poste de maintenance</title>
<style>
:root{
  color-scheme:dark;
  --bg:#0b1117;--panel:#111a23;--panel2:#16222d;--head:#1b2a36;
  --ink:#edf3f7;--mut:#91a2b1;--line:#2a3a47;--steel:#101820;
  --yel:#ffb81c;--yel2:#ffd166;--ok:#49d597;--okbg:#102e27;
  --mid:#ffb547;--midbg:#382811;--high:#ff6b61;--highbg:#3b191a;
  --shadow:0 18px 42px rgba(0,0,0,.22)
}
*{box-sizing:border-box}
html{min-height:100%;background:var(--bg)}
body{margin:0;background:
  radial-gradient(ellipse at 15% -15%,rgba(255,184,28,.09),transparent 34%),
  linear-gradient(180deg,#0d151d 0%,#0a1016 100%);
  color:var(--ink);font:14px/1.55 "Bahnschrift","DIN Alternate","Segoe UI",Arial,sans-serif;
  letter-spacing:.01em;min-height:100vh}
:focus-visible{outline:2px solid var(--yel);outline-offset:3px}
header{position:relative;overflow:hidden;background:linear-gradient(105deg,#111c26,#1a2935 68%,#101820);
  color:var(--ink);display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between;
  padding:24px clamp(18px,4vw,56px);border-bottom:1px solid #34434f}
header:after{content:"";position:absolute;right:0;top:0;width:34%;height:100%;pointer-events:none;
  opacity:.18;background:repeating-linear-gradient(135deg,transparent 0 14px,#71808c 14px 15px)}
header>div{position:relative;z-index:1}
header h1{margin:0;font-size:clamp(1.35rem,2.5vw,2rem);font-weight:750;letter-spacing:.07em;text-transform:uppercase}
header h1:before{content:"";display:inline-block;width:8px;height:27px;background:var(--yel);margin-right:13px;vertical-align:-4px}
header p{margin:7px 0 0 22px;color:#9babb8;font-size:.9rem;letter-spacing:.04em}
.stripe{height:5px;background:repeating-linear-gradient(135deg,var(--yel) 0 12px,#242d35 12px 24px);box-shadow:0 2px 12px #0008}
.chip{display:flex;align-items:center;gap:9px;flex-wrap:wrap;border:1px solid #40515f;border-radius:4px;
  padding:9px 13px;font-size:.78rem;background:#0c141b;color:#c7d2db;box-shadow:inset 0 0 0 1px #ffffff05}
.dot{width:9px;height:9px;border-radius:50%;background:#788896;box-shadow:0 0 0 4px #78889620}
.dot.on{background:var(--ok);box-shadow:0 0 0 4px #49d59720}
.dot.off{background:var(--high);box-shadow:0 0 0 4px #ff6b6120}
main{max-width:1480px;margin:0 auto;padding:clamp(18px,3vw,36px);display:grid;grid-template-columns:minmax(310px,390px) minmax(0,1fr);gap:22px;align-items:start}
@media(max-width:860px){main{grid-template-columns:1fr;padding:16px}}
.panel{min-width:0;background:linear-gradient(180deg,#131e28,#101820);border:1px solid #2b3b48;border-radius:7px;box-shadow:var(--shadow);overflow:hidden}
.panel>h2{margin:0;padding:15px 18px;background:linear-gradient(90deg,#1b2a36,#17232d);border-bottom:1px solid var(--line);
  border-left:4px solid var(--yel);font-size:.86rem;font-weight:750;letter-spacing:.12em;text-transform:uppercase}
.panel>h2:before{content:"//";color:var(--yel);margin-right:10px;font-weight:800}
.body{padding:20px}
.seg{display:grid;grid-template-columns:1fr 1fr;border:1px solid #344653;border-radius:5px;overflow:hidden;margin-bottom:22px;background:#0b131a;padding:4px;gap:4px}
.seg button{padding:10px 8px;border:1px solid transparent;border-radius:3px;background:transparent;color:var(--mut);font:inherit;font-size:.85rem;font-weight:650;cursor:pointer;transition:background .18s,color .18s,border-color .18s}
.seg button:hover{color:var(--ink);background:#1b2a35}
.seg button.on{background:var(--yel);color:#151b20;border-color:var(--yel);font-weight:800;box-shadow:0 3px 12px #ffb81c22}
.f{margin-bottom:17px}.f label{display:block;font-size:.79rem;color:#c0ccd5;margin-bottom:7px;font-weight:650;letter-spacing:.025em}
.f div{display:flex;min-width:0}
input,select{width:100%;min-width:0;padding:11px 12px;border:1px solid #344653;border-radius:4px;background:#0a1219;color:var(--ink);font:inherit;font-variant-numeric:tabular-nums;transition:border-color .15s,box-shadow .15s}
input:hover,select:hover{border-color:#526879}
input:focus,select:focus{outline:none;border-color:var(--yel);box-shadow:0 0 0 3px #ffb81c18}
input[type=file]{padding:10px;font-size:.8rem}
.f span{display:flex;align-items:center;padding:0 12px;background:#202d38;border:1px solid #344653;border-left:0;border-radius:0 4px 4px 0;color:#aebdc8;font-size:.78rem;white-space:nowrap}
.f input{border-radius:4px 0 0 4px}
.go{width:100%;margin-top:8px;padding:13px 15px;border:1px solid #ffca4b;border-radius:4px;
  background:linear-gradient(180deg,#ffc63e,#ffb31a);color:#171d22;font:inherit;font-weight:850;font-size:.85rem;
  letter-spacing:.07em;text-transform:uppercase;cursor:pointer;box-shadow:0 5px 16px #ffb81c1a;transition:transform .15s,filter .15s,box-shadow .15s}
.go:before{content:"▶";font-size:.7rem;margin-right:10px}
.go:hover{filter:brightness(1.07);box-shadow:0 7px 22px #ffb81c30;transform:translateY(-1px)}
.go:active{transform:translateY(0)}
.go:disabled{opacity:.55;cursor:wait;transform:none}
.hint{color:var(--mut);font-size:.8rem;margin:12px 0 0;line-height:1.6}
.empty{padding:clamp(40px,7vw,78px) 24px;text-align:center;color:var(--mut);line-height:1.8}
.empty:before{content:"⌁";display:block;font-size:3rem;color:#536879;margin-bottom:12px}
.err{background:var(--highbg);color:#ffb7b1;border:1px solid #783c3b;border-left:4px solid var(--high);border-radius:4px;padding:14px 16px}
.err ul{margin:8px 0 0;padding-left:20px}
.ok{background:var(--okbg);color:var(--ok)}.mid{background:var(--midbg);color:var(--mid)}.high{background:var(--highbg);color:var(--high)}
.verdict{padding:17px 18px;border:1px solid currentColor;border-left-width:4px;border-radius:4px;margin-top:18px;background:#ffffff04}
.verdict h3{margin:0 0 6px;font-size:1.25rem;letter-spacing:.01em}
.gauge{display:block;width:100%;max-width:380px;margin:0 auto}
.gauge .zone{fill:none;stroke-width:17;stroke-linecap:butt}
.needle{transition:transform .9s cubic-bezier(.2,.8,.2,1);transform-origin:110px 110px}
@media(prefers-reduced-motion:reduce){.needle{transition:none}*{scroll-behavior:auto!important;transition:none!important}}
.read{text-align:center;margin-top:-4px}
.read b{font-size:clamp(2.4rem,5vw,3.3rem);font-weight:800;letter-spacing:-.04em;font-variant-numeric:tabular-nums;line-height:1.2}
.read div{color:var(--mut);font-size:.8rem;margin-top:5px}
.kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:5px;overflow:hidden;margin-bottom:20px}
.kpi div{background:linear-gradient(145deg,#17232d,#111a23);padding:16px;color:var(--mut);font-size:.75rem;text-transform:uppercase;letter-spacing:.045em}
.kpi b{display:block;font-size:clamp(1.5rem,2.7vw,2rem);color:var(--ink);font-weight:800;font-variant-numeric:tabular-nums;line-height:1.3;margin-bottom:5px}
.scroll{overflow-x:auto;border:1px solid var(--line);border-radius:4px}
table{width:100%;border-collapse:collapse;min-width:540px}
th{text-align:left;font-weight:750;font-size:.73rem;color:#aebdc8;background:#1b2a36;padding:12px 14px;border-bottom:1px solid #40515f;text-transform:uppercase;letter-spacing:.07em}
td{padding:12px 14px;border-bottom:1px solid #253541;font-variant-numeric:tabular-nums}
tbody tr{background:#111a23;transition:background .15s}
tbody tr:nth-child(even){background:#14202a}
tbody tr:hover{background:#1d2b36}
tbody tr:last-child td{border-bottom:0}
.pill{display:inline-block;padding:4px 9px;border:1px solid currentColor;border-radius:3px;font-weight:800;font-size:.7rem;text-transform:uppercase;letter-spacing:.06em}
.bar{display:inline-block;width:70px;height:6px;background:#2a3a47;margin-left:9px;vertical-align:middle;border-radius:1px;overflow:hidden}
.bar i{display:block;height:100%;background:currentColor}
.plage{display:block;font-size:.73rem;color:#8093a2;margin-bottom:6px}
.plage.hors{color:var(--mid);font-weight:700}
input.hors{border-color:var(--mid);box-shadow:inset 3px 0 0 var(--mid)}
[hidden]{display:none!important}
@media(max-width:540px){header{padding:18px}header .chip{width:100%}.body{padding:15px}.panel>h2{padding:13px 15px}.kpi{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* ===== Finition industrielle premium ===== */
:root{--steel:#111820;--bg:#e8ecef;--panel:#f8fafb;--head:#e3e9ed;--ink:#17232d;--mut:#657582;--line:#c7d1d8;--yel:#ffc400;--ok:#167647;--okbg:#dff5e8;--mid:#a65b00;--midbg:#fff0d2;--high:#bd2929;--highbg:#ffe3e0}
@media(prefers-color-scheme:dark){:root{--bg:#0b1117;--panel:#121b23;--head:#1b2833;--ink:#eaf0f4;--mut:#9aabb8;--line:#2b3a46;--ok:#5bdb95;--okbg:#102e22;--mid:#ffc15c;--midbg:#38270d;--high:#ff8177;--highbg:#391816}}
body{min-height:100vh;display:flex;flex-direction:column;background-image:linear-gradient(rgba(100,125,140,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(100,125,140,.045) 1px,transparent 1px);background-size:24px 24px}
header{position:relative;padding:18px clamp(16px,3vw,42px);border-bottom:1px solid #34424e;box-shadow:0 8px 24px #00000018}
header:before{content:"INDUSTRIAL MONITORING / PM-01";display:block;position:absolute;right:clamp(16px,3vw,42px);bottom:5px;color:#71808b;font-size:9px;letter-spacing:.16em}
header h1{font-size:clamp(1.2rem,2.1vw,1.65rem);letter-spacing:.055em;text-transform:uppercase}
header h1:before{content:"";display:inline-block;width:9px;height:26px;background:var(--yel);margin-right:12px;vertical-align:-6px;box-shadow:4px 0 0 #ffc40045}
header p{padding-left:21px;letter-spacing:.025em}
.stripe{height:5px;background:repeating-linear-gradient(-45deg,var(--yel) 0 9px,#202a33 9px 18px)}
main{flex:1;width:100%;max-width:1440px;padding:clamp(16px,2.6vw,34px);gap:22px;grid-template-columns:minmax(310px,390px) minmax(0,1fr)}
.panel{overflow:hidden;border-radius:5px;box-shadow:0 8px 22px #10202c0b;transition:border-color .2s,box-shadow .2s}
.panel:hover{border-color:#9baab5;box-shadow:0 12px 28px #10202c12}
.panel>h2{padding:13px 17px;text-transform:uppercase;letter-spacing:.09em;font-size:.82rem}
.panel>h2:after{content:"SECTION";float:right;color:var(--mut);font-size:.65rem;letter-spacing:.12em;font-weight:500;opacity:.8}
.panel .body{padding:20px}
.seg{padding:3px;background:var(--head);gap:3px;border:0}
.seg button{border-radius:3px;font-size:.9rem;transition:background .18s,color .18s}
.seg button.on{background:var(--steel);box-shadow:0 2px 5px #0002}
.f{margin-bottom:16px}.f label{font-weight:650;color:var(--ink);letter-spacing:.01em}
input,select{border-radius:4px;transition:border-color .15s,box-shadow .15s}
input:focus,select:focus{outline:none;border-color:#d29f00;box-shadow:0 0 0 3px #ffc4002b}
.f span{border-radius:0 4px 4px 0;font-weight:650}
.go{border-radius:4px;text-transform:uppercase;letter-spacing:.055em;box-shadow:0 3px 0 #b88900;transition:transform .15s,filter .15s,box-shadow .15s}
.go:hover{filter:brightness(1.04);transform:translateY(-1px);box-shadow:0 4px 0 #b88900}
.go:active{transform:translateY(1px);box-shadow:0 1px 0 #b88900}
.kpi{border-radius:4px;overflow:hidden;gap:1px}
.kpi div{position:relative;padding:15px 16px 13px;border-top:3px solid transparent}
.kpi div:before{content:"";position:absolute;top:0;left:0;width:30px;height:3px;background:var(--yel)}
.kpi b{font-size:clamp(1.45rem,2vw,1.9rem);letter-spacing:-.04em;margin-bottom:4px}
th{letter-spacing:.04em;text-transform:uppercase;font-size:.72rem}
tbody tr{transition:background .15s}tbody tr:nth-child(even){background:color-mix(in srgb,var(--head) 42%,transparent)}tbody tr:hover{background:color-mix(in srgb,var(--yel) 13%,var(--panel))}
td{font-size:.9rem}.pill{display:inline-block;min-width:76px;text-align:center;text-transform:uppercase;letter-spacing:.04em}
.verdict{border-radius:0 4px 4px 0;padding:17px 18px}.verdict h3{letter-spacing:.015em}
.empty{padding:clamp(40px,7vw,76px) 20px;line-height:1.8}
.empty:before{content:"◉";display:block;font-size:2rem;color:var(--yel);margin-bottom:10px}
footer{position:relative;background:var(--steel);color:#c5ced5;border-top:4px solid var(--yel);padding:19px clamp(16px,3vw,42px);display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.78rem}
.footer-brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#f1f4f6}
.footer-mark{display:grid;place-items:center;width:30px;height:30px;border:1px solid #64727e;color:var(--yel);font-size:1.05rem;font-weight:800}
.footer-copy{color:#9eabb5}.footer-copy strong{color:#e5ebef;font-weight:600}.footer-meta{display:flex;align-items:center;gap:8px;color:#aab6bf;letter-spacing:.04em}
.footer-led{width:7px;height:7px;border-radius:50%;background:#43d483;box-shadow:0 0 0 3px #43d48320}
@media(max-width:860px){main{grid-template-columns:1fr}header:before{display:none}footer{align-items:flex-start;flex-direction:column;gap:10px}}
@media(max-width:480px){.panel .body{padding:14px}.kpi{grid-template-columns:repeat(2,minmax(0,1fr))}.bar{width:45px}header{padding-bottom:16px}}


/* Correctif de contraste : palette sombre cohérente sur tous les écrans */
:root{
  color-scheme:dark;
  --bg:#0b1117;--panel:#121b23;--panel2:#16222d;--head:#1b2833;
  --ink:#f1f5f8;--mut:#b0bec8;--line:#344653;--steel:#111820;
  --yel:#ffc400;--yel2:#ffd166;--ok:#5bdb95;--okbg:#102e22;
  --mid:#ffc15c;--midbg:#38270d;--high:#ff8177;--highbg:#391816;
  --shadow:0 18px 42px rgba(0,0,0,.28)
}
body{color:var(--ink);background-color:var(--bg)}
.panel,.panel .body{color:var(--ink)}
.f label,.panel>h2,.read,.kpi div,td{color:var(--ink)}
.hint,.empty,.read div{color:#b0bec8}
input,select{color:#f1f5f8;background:#0a1219}
input::placeholder{color:#aab8c2;opacity:1}
footer{color:#e1e8ed}
.footer-copy{color:#c0cbd3}


/* Lisibilité des choix de saisie et du sélecteur CSV */
.header-actions{position:relative;z-index:2;display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap}
.theme-toggle{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:9px 13px;border:1px solid #657582;border-radius:4px;background:#202d38;color:#f1f5f8;font:inherit;font-size:.8rem;font-weight:750;cursor:pointer;transition:background .18s,border-color .18s,transform .18s}
.theme-toggle:hover{background:#30414e;border-color:var(--yel);transform:translateY(-1px)}
.theme-icon{font-size:1rem;line-height:1}
.seg button{color:#e4edf3;min-height:42px}
.seg button.on{background:var(--yel);color:#171d22;border-color:var(--yel);box-shadow:0 2px 8px #0003}
.seg button.on:hover{color:#171d22;background:#ffd34f}
.f input[type=file]{display:block;width:100%;min-height:48px;padding:7px;background:#111d27;color:#f1f5f8;border:1px solid #718391;border-radius:4px;font-size:.85rem;cursor:pointer}
.f input[type=file]::file-selector-button{margin-right:12px;padding:9px 12px;border:1px solid #8797a3;border-radius:3px;background:#344653;color:#fff;font:inherit;font-weight:750;cursor:pointer}
.f input[type=file]::file-selector-button:hover{background:#455b6b}
#fichier{overflow:hidden}
#p-csv .hint{padding:10px 12px;background:#172630;border-left:3px solid var(--yel);border-radius:3px;color:#d0dbe2;overflow-wrap:anywhere}
/* Le mode clair est une vraie bascule, sans modifier le fonctionnement de l'API */
body.light{--bg:#edf2f5;--panel:#ffffff;--panel2:#f3f6f8;--head:#e1e8ed;--ink:#182630;--mut:#4f626f;--line:#b8c6cf;--steel:#e5ebef;--ok:#12683e;--okbg:#dff5e8;--mid:#8c4b00;--midbg:#fff0d2;--high:#a51f1f;--highbg:#ffe3e0;--shadow:0 14px 32px rgba(28,48,62,.10);color:var(--ink);background-color:var(--bg);background-image:linear-gradient(rgba(45,65,80,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(45,65,80,.045) 1px,transparent 1px)}
body.light header{background:linear-gradient(105deg,#e9eff3,#d9e3e9 68%,#e7edf1);color:#17232d;border-bottom-color:#b8c6cf}
body.light header p{color:#526571}
body.light header:before{color:#536672}
body.light .chip{background:#fff;color:#293b47;border-color:#b6c4cd}
body.light .panel{background:linear-gradient(180deg,#fff,#f7f9fa);border-color:#c4d0d7}
body.light .panel>h2{background:linear-gradient(90deg,#e4ebef,#f0f4f6);color:#17232d;border-bottom-color:#c4d0d7}
body.light .panel>h2:after{color:#5c6e79}
body.light .seg{background:#e5ebef;border-color:#c2cdd4}
body.light .seg button{color:#344956}
body.light .seg button.on{background:#172630;color:#fff;border-color:#172630}
body.light .seg button.on:hover{background:#293d4a;color:#fff}
body.light input,body.light select{background:#fff;color:#17232d;border-color:#b8c6cf}
body.light input::placeholder{color:#60727e}
body.light .f span{background:#e2e9ed;color:#344956;border-color:#b8c6cf}
body.light .f input[type=file]{background:#fff;color:#17232d;border-color:#b8c6cf}
body.light .f input[type=file]::file-selector-button{background:#e0e8ed;color:#17232d;border-color:#a9b8c2}
body.light #p-csv .hint{background:#f4f7f9;color:#344956}
body.light .kpi div{background:linear-gradient(145deg,#fff,#f0f4f6);color:#4f626f}
body.light .kpi b{color:#17232d}
body.light th{background:#e2e9ed;color:#344956;border-bottom-color:#bdcbd3}
body.light tbody tr{background:#fff}
body.light tbody tr:nth-child(even){background:#f1f5f7}
body.light tbody tr:hover{background:#fff4ce}
body.light td{border-bottom-color:#d7e0e5;color:#17232d}
body.light .empty{color:#526571}
body.light .hint,body.light .read div{color:#526571}
body.light footer{background:#e1e8ed;color:#293b47;border-top-color:#d29f00}
body.light .footer-brand{color:#17232d}
body.light .footer-copy{color:#526571}
body.light .footer-copy strong{color:#17232d}
body.light .footer-meta{color:#526571}
body.light .footer-mark{border-color:#9aaab4}
body.light .theme-toggle{background:#fff;color:#17232d;border-color:#aab9c3}
body.light .theme-toggle:hover{background:#f1f5f7}
@media(max-width:600px){.header-actions{width:100%;justify-content:flex-start}.theme-toggle{flex:0 0 auto}.header-actions .chip{width:auto;max-width:100%}}



/* ===== Mise en page compacte : saisie en deux colonnes + diagnostic visible ===== */
@media (min-width: 1050px) {
  main {
    grid-template-columns: minmax(450px, .92fr) minmax(0, 1.08fr);
    gap: 18px;
    padding: 14px 22px;
    align-items: stretch;
  }
  main > .panel { min-height: 0; }
  main > .panel:first-child .body { padding: 14px 16px; }
  .seg { margin-bottom: 12px; }
  #p-form > .f { margin-bottom: 10px; }
  #champs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 12px;
    row-gap: 0;
  }
  #champs .f { min-width: 0; margin-bottom: 8px; }
  #champs .f label { min-height: 2.2em; margin-bottom: 4px; font-size: .76rem; }
  #champs .plage { min-height: 1.25em; margin-bottom: 4px; font-size: .66rem; line-height: 1.25; }
  #champs input { padding: 8px 9px; font-size: .88rem; }
  #champs .f span { padding: 0 8px; font-size: .72rem; }
  #p-form .go, #p-csv .go { margin-top: 5px; padding: 10px 12px; }
  #p-csv .f { margin-bottom: 10px; }
  #p-csv .hint { margin-top: 8px; font-size: .75rem; line-height: 1.45; }
  .empty { padding: 30px 18px; }
  #sortie { min-width: 0; }
}
@media (min-width: 1050px) and (max-height: 800px) {
  header { padding-top: 12px; padding-bottom: 12px; }
  header p { margin-top: 3px; font-size: .8rem; }
  .stripe { height: 4px; }
  main { padding-top: 10px; padding-bottom: 10px; }
  .panel > h2 { padding-top: 10px; padding-bottom: 10px; }
  #champs .f label { min-height: 1.7em; }
  #champs .plage { font-size: .62rem; }
  .empty { padding-top: 22px; padding-bottom: 22px; }
  footer { padding-top: 10px; padding-bottom: 10px; }
}
@media (max-width: 1049px) {
  #champs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 12px; }
}
@media (max-width: 560px) {
  #champs { grid-template-columns: 1fr; }
  #champs .f label { min-height: 0; }
}


/* Correctif de mise en page vérifié */
@media (min-width: 861px) {
  main { display:grid; grid-template-columns:minmax(440px, .95fr) minmax(0, 1.05fr); align-items:start; }
  main > .panel { min-width:0; }
  #champs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 12px; }
  #champs .f { min-width:0; }
  #sortie { min-width:0; padding:14px; }
  .kpi { grid-template-columns:repeat(2,minmax(0,1fr)); margin-bottom:12px; }
  .kpi div { padding:11px; }
  .verdict { margin-top:10px; padding:12px; }
}
@media (max-width: 860px) {
  main { grid-template-columns:minmax(0,1fr); }
  #champs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 10px; }
  #sortie { padding:12px; }
}
@media (max-width: 560px) { #champs { grid-template-columns:1fr; } }

</style>
</head>
<body>
<header>
  <div><h1>Poste de maintenance</h1><p>SUPERVISION INDUSTRIELLE · DÉTECTION PRÉDICTIVE DES ANOMALIES</p></div>
  <div class="header-actions"><button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false" title="Basculer entre le mode sombre et le mode clair"><span class="theme-icon" aria-hidden="true">☀</span><span class="theme-label">Mode clair</span></button><div class="chip" id="etat"><span class="dot"></span><span>Connexion à l’API…</span></div></div>
</header>
<div class="stripe"></div>

<main>
  <section class="panel">
    <h2>Mesures</h2>
    <div class="body">
      <div class="seg"><button id="t-form" class="on" type="button">Une machine</button><button id="t-csv" type="button">Fichier CSV</button></div>
      <div id="p-form">
        <div class="f"><label for="quality_level">Niveau de qualité</label>
          <select id="quality_level"><option value="L">L (basse)</option><option value="M">M (moyenne)</option><option value="H">H (haute)</option></select></div>
        <div id="champs"></div>
        <button class="go" id="go-form" type="button">Analyser la machine</button>
      </div>
      <div id="p-csv" hidden>
        <div class="f"><label for="fichier">Fichier CSV, une machine par ligne</label><input type="file" id="fichier" accept=".csv,text/csv"></div>
        <p class="hint">Colonnes : quality_level, air_temperature_k, process_temperature_k, rotational_speed_rpm, torque_nm, tool_wear_min.</p>
        <button class="go" id="go-csv" type="button">Analyser le fichier</button>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>Diagnostic</h2>
    <div id="sortie"><div class="empty">Aucune analyse pour l’instant.<br>Saisissez les mesures d’une machine, ou choisissez un fichier, puis lancez l’analyse.</div></div>
  </section>
</main>


<footer aria-label="Pied de page">
  <div class="footer-brand"><span class="footer-mark">©</span><span>Predictive Maintenance</span></div>
  <div class="footer-copy">© <span id="annee-copyright"></span> <strong>Poste de maintenance</strong> · Tous droits réservés.</div>
  <div class="footer-meta"><span class="footer-led" aria-hidden="true"></span><span>SUPERVISION INDUSTRIELLE</span><span aria-hidden="true">·</span><span>PM-01</span></div>
</footer>

<script>
document.getElementById("annee-copyright").textContent = new Date().getFullYear();

const themeToggle = document.getElementById("theme-toggle");
const themeLabel = themeToggle.querySelector(".theme-label");
const themeIcon = themeToggle.querySelector(".theme-icon");
themeToggle.addEventListener("click", () => {
  const clair = document.body.classList.toggle("light");
  themeToggle.setAttribute("aria-pressed", String(clair));
  themeLabel.textContent = clair ? "Mode sombre" : "Mode clair";
  themeIcon.textContent = clair ? "☾" : "☀";
});


const CHAMPS = [
  ["air_temperature_k", "Température de l’air", 298.1, "K", 295, 305],
  ["process_temperature_k", "Température du process", 308.6, "K", 305, 314],
  ["rotational_speed_rpm", "Vitesse de rotation", 1551, "tr/min", 1168, 2886],
  ["torque_nm", "Couple", 42.8, "Nm", 3.8, 76.6],
  ["tool_wear_min", "Usure de l’outil", 0, "min", 0, 253],
];
const NIVEAU = {"aucune": "ok", "modérée": "mid", "élevée": "high"};
const CONSEIL = {"aucune": "Aucune action nécessaire.", "modérée": "Planifier une inspection de la machine.",
  "élevée": "Inspecter la machine rapidement, avant que la panne ne survienne."};
let SEUIL = 0.575, SEUIL_H = 0.8;
const $ = (s) => document.querySelector(s);
const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c]));
const fmt = (x) => Number(x).toLocaleString("fr-FR", {minimumFractionDigits: 3, maximumFractionDigits: 3});

const nb = (x) => x.toLocaleString("fr-FR");
$("#champs").innerHTML = CHAMPS.map(([id, nom, v, u]) =>
  `<div class="f"><label for="${id}">${nom}</label><small class="plage" id="plage-${id}"></small><div><input id="${id}" type="number" step="any" value="${v}"><span>${u}</span></div></div>`).join("");
for (const [id, , , u, lo, hi] of CHAMPS) {
  const champ = $("#" + id), note = $("#plage-" + id);
  const verifier = () => {
    const v = parseFloat(champ.value), hors = !isNaN(v) && (v < lo || v > hi);
    champ.classList.toggle("hors", hors); note.classList.toggle("hors", hors);
    note.textContent = hors ? `Hors de la plage observée (${nb(lo)} à ${nb(hi)} ${u}) : résultat peu fiable`
                            : `Plage observée : ${nb(lo)} à ${nb(hi)} ${u}`;
  };
  champ.addEventListener("input", verifier); verifier();
}

fetch("/health").then((r) => r.json()).then((h) => {
  SEUIL = h.seuil_anomalie; SEUIL_H = h.seuil_alerte_elevee;
  $("#etat").innerHTML = `<span class="dot on"></span><span>Modèle ${esc(h.modele)}, version ${h.version}</span><span>Seuil ${fmt(h.seuil_anomalie)}</span>`;
}).catch(() => { $("#etat").innerHTML = `<span class="dot off"></span><span>API injoignable</span>`; });

function onglet(forme) {
  $("#p-form").hidden = !forme; $("#p-csv").hidden = forme;
  $("#t-form").classList.toggle("on", forme); $("#t-csv").classList.toggle("on", !forme);
}
$("#t-form").onclick = () => onglet(true);
$("#t-csv").onclick = () => onglet(false);

function erreur(detail) {
  let titre = "Une erreur est survenue.", liste = [];
  if (typeof detail === "string") titre = detail;
  else if (Array.isArray(detail)) { titre = "Valeurs invalides :"; liste = detail.map((e) => `${e.loc[e.loc.length - 1]} : ${e.msg}`); }
  else if (detail && detail.message) { titre = detail.message; liste = detail.exemples || []; }
  $("#sortie").innerHTML = `<div class="body"><div class="err"><b>${esc(titre)}</b>` +
    (liste.length ? `<ul>${liste.map((l) => `<li>${esc(l)}</li>`).join("")}</ul>` : "") + `</div></div>`;
}

async function appeler(bouton, url, options, afficher) {
  bouton.disabled = true;
  try { const r = await fetch(url, options), j = await r.json(); r.ok ? afficher(j) : erreur(j.detail); }
  catch (e) { erreur("Impossible de joindre l’API. Est-elle bien lancée ?"); }
  bouton.disabled = false;
}

function point(v, r) { const a = Math.PI * (1 - v); return [(110 + r * Math.cos(a)).toFixed(1), (110 - r * Math.sin(a)).toFixed(1)]; }
function arc(v1, v2, couleur) {
  const [x1, y1] = point(v1, 90), [x2, y2] = point(v2, 90);
  return `<path class="zone" stroke="${couleur}" d="M${x1} ${y1} A90 90 0 0 1 ${x2} ${y2}"/>`;
}
function cadran(score) {
  return `<svg class="gauge" viewBox="0 0 220 130" role="img" aria-label="Score d’anomalie ${fmt(score)}">
    ${arc(0, SEUIL, "var(--ok)")}${arc(SEUIL, SEUIL_H, "var(--mid)")}${arc(SEUIL_H, 1, "var(--high)")}
    <g class="needle" id="aiguille" style="transform:rotate(0deg)"><line x1="110" y1="110" x2="34" y2="110" stroke="var(--ink)" stroke-width="3"/><circle cx="110" cy="110" r="6" fill="var(--ink)"/></g>
    <text x="14" y="126" fill="var(--mut)" font-size="10">0</text><text x="196" y="126" fill="var(--mut)" font-size="10">1</text></svg>`;
}

$("#go-form").onclick = () => {
  const corps = {quality_level: $("#quality_level").value};
  for (const [id] of CHAMPS) corps[id] = parseFloat($("#" + id).value);
  appeler($("#go-form"), "/predict", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify(corps)}, (j) => {
    SEUIL = j.seuil;
    const n = NIVEAU[j.niveau_alerte];
    $("#sortie").innerHTML = `<div class="body">${cadran(j.score)}
      <div class="read"><b>${fmt(j.score)}</b><div>Score d’anomalie, signalé à partir de ${fmt(j.seuil)}</div></div>
      <div class="verdict ${n}"><h3>${j.resultat === "anormal" ? "Machine anormale" : "Machine normale"}</h3>
      <div>Niveau d’alerte : <b>${j.niveau_alerte}</b>. ${CONSEIL[j.niveau_alerte]}</div></div></div>`;
    setTimeout(() => { $("#aiguille").style.transform = `rotate(${180 * Math.min(Math.max(j.score, 0), 1)}deg)`; }, 40);
  });
};

$("#go-csv").onclick = () => {
  const f = $("#fichier").files[0];
  if (!f) return erreur("Choisissez d’abord un fichier CSV.");
  const donnees = new FormData(); donnees.append("fichier", f);
  appeler($("#go-csv"), "/predict_csv", {method: "POST", body: donnees}, (j) => {
    const lignes = j.resultats.slice().sort((a, b) => b.score - a.score).map((r) => {
      const n = NIVEAU[r.niveau_alerte];
      return `<tr><td>${esc(r.identifiant ?? "ligne " + r.ligne)}</td><td>${r.resultat}</td>
        <td class="${n}" style="background:none">${fmt(r.score)}<span class="bar"><i style="width:${Math.round(r.score * 100)}%"></i></span></td>
        <td><span class="pill ${n}">${r.niveau_alerte}</span></td></tr>`;
    }).join("");
    const taux = j.n_machines ? Math.round(100 * j.n_anormales / j.n_machines) : 0;
    $("#sortie").innerHTML = `<div class="body"><div class="kpi">
      <div><b>${j.n_machines}</b>machines analysées</div><div><b>${j.n_anormales}</b>anormales</div>
      <div><b>${j.n_alerte_elevee}</b>alertes élevées</div><div><b>${taux} %</b>de machines anormales</div></div>
      <div class="scroll"><table><thead><tr><th>Machine</th><th>Résultat</th><th>Score</th><th>Alerte</th></tr></thead><tbody>${lignes}</tbody></table></div>
      <p class="hint">Trié du plus au moins urgent.</p></div>`;
  });
};
</script>
</body>
</html>